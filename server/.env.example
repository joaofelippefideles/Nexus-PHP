# ==========================================================================
# NEXUS TECH — API / variáveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores do SEU ambiente.
# NUNCA versionar o `.env` real (já está no .gitignore da raiz).
# ==========================================================================

# Porta HTTP do servidor
PORT=4000

# Ambiente: development | production
NODE_ENV=development

# Origem permitida no CORS (origem do frontend local)
# Ex.: http://127.0.0.1:8123  ou  http://localhost:5500
CORS_ORIGIN=http://127.0.0.1:8123

# --- MySQL ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexus_tech_db

# --- Admin (autenticação) -------------------------------------------------
# Preencha no .env LOCAL (nunca versionar valores reais).
# ADMIN_EMAIL: e-mail do administrador inicial (npm run seed:admin).
# ADMIN_NAME: nome exibido no painel.
# ADMIN_PASSWORD: senha do administrador (>= 8 caracteres; hash bcrypt cost 12).
# ADMIN_JWT_SECRET / ADMIN_REFRESH_SECRET: segredos do access/refresh token.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_REFRESH_SECRET=
